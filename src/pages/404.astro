---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — HydroRigor" description="The requested HydroRigor page could not be found.">
  <section class="py-28">
    <div class="hr-container text-center">
      <p class="font-mono text-sm font-semibold text-hydro-teal">404</p>
      <h1 class="mt-3 font-heading text-5xl font-extrabold tracking-[-0.05em] text-hydro-deep">That channel runs dry.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-slate">The page you requested does not exist in the HydroRigor foundation.</p>
      <a class="hr-focus mt-8 inline-flex rounded-[10px] bg-hydro-teal px-5 py-3 font-bold text-white no-underline" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
