---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — HydroRigor" description="The requested HydroRigor page could not be found." noindex={true} omitCanonical={true}>
  <section class="py-28">
    <div class="hr-container text-center">
      <p class="font-mono text-sm font-semibold text-hydro-teal">404</p>
      <h1 class="mt-3 font-heading text-5xl font-extrabold tracking-[-0.05em] text-hydro-deep">That channel runs dry.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-slate">The page you requested does not exist. Use the beginner path or search the public site architecture.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="hr-focus inline-flex rounded-[10px] bg-hydro-teal px-5 py-3 font-bold text-white no-underline" href="/">Return home</a>
        <a class="hr-focus inline-flex rounded-[10px] border border-hydro-teal/30 bg-white px-5 py-3 font-bold text-hydro-deep no-underline" href="/search/">Search HydroRigor</a>
      </div>
    </div>
  </section>
</BaseLayout>
