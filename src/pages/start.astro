---
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { photos } from '../data/photos.ts';
import { getPublicSectionPath } from '../lib/sections.ts';
import { brandedShareImage } from '../lib/social-image.ts';

const banner = photos['lettuce-net-pots-clay'];
const image = brandedShareImage('start', 'Start with the decision you need to make.', banner);

const decisionPaths = [
  {
    question: 'I am new to hydroponics',
    answer: 'Start with what a home system needs: how roots get water and oxygen, how much light the crop wants, and how much upkeep you can give it.',
    label: 'Read the home systems guide',
    href: '/systems/indoor-hydroponic-systems-for-home/',
  },
  {
    question: 'I need to choose a system',
    answer: 'Compare deep water culture, NFT, Kratky, towers and drip by space, moving parts, crop fit and what happens if the power goes out.',
    label: 'Choose a system path',
    href: getPublicSectionPath('systems'),
  },
  {
    question: 'I need to choose a crop',
    answer: 'Lettuce is the easiest first crop. Strawberries and tomatoes need more light and attention. Each crop guide lists sourced pH, EC and light targets.',
    label: 'Choose a crop path',
    href: getPublicSectionPath('crops'),
  },
  {
    question: 'I need to understand nutrients or water',
    answer: 'Learn what a complete nutrient contains, how to mix A and B parts safely, and how to read pH and EC on a meter.',
    label: 'Read the nutrients guide',
    href: '/nutrients-water/hydroponic-nutrients/',
  },
  {
    question: 'I need to choose equipment',
    answer: 'Lights, pumps, air stones and meters matter more than the brand on the box. Plan the whole indoor setup before you buy parts.',
    label: 'Plan the whole setup',
    href: '/systems/indoor-hydroponic-systems-for-home/#account-for-the-whole-indoor-environment',
  },
  {
    question: 'Something is going wrong',
    answer: 'Check pH, EC, water temperature and light first: they explain most problems. The lettuce and strawberry guides include symptom-and-fix tables.',
    label: 'See common fixes',
    href: '/crops/hydroponic-lettuce/#troubleshooting-common-problems',
  },
] as const;
---
<BaseLayout title="Start Here — HydroRigor" description="New to hydroponics? Pick the question closest to your situation and follow a short path to the right system, crop, nutrient and troubleshooting guides." image={image}>
  <section class="py-14 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: 'Start Here', url: '/start/' },
      ]} />
      <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_.9fr]">
        <div>
          <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">New to hydroponics</p>
          <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">Start with the decision you need to make.</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate">You do not need to learn every hydroponic concept at once. Choose the question closest to your situation and read the one guide that answers it.</p>
        </div>
        <figure data-pagefind-ignore="all">
          <div class="aspect-[4/3] overflow-hidden rounded-[1.75rem] bg-water-mist">
            <Photo photo={banner} eager sizes="(min-width: 1024px) 540px, calc(100vw - 2rem)" widths={[400, 640, 960, 1280]} class="h-full w-full object-cover" />
          </div>
          <figcaption><PhotoCredit photo={banner} class="mt-2" /></figcaption>
        </figure>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {decisionPaths.map((path) => (
          <article class="flex h-full flex-col rounded-2xl border border-line bg-white p-6">
            <h2 class="font-heading text-xl font-bold text-hydro-deep">{path.question}</h2>
            <p class="mt-3 grow text-sm leading-6 text-slate">{path.answer}</p>
            <a class="hr-focus mt-6 rounded-md font-bold text-hydro-teal underline decoration-hydro-teal/30 underline-offset-4" href={path.href}>{path.label} →</a>
          </article>
        ))}
      </div>

      <section class="mt-16 rounded-2xl bg-hydro-deep p-7 text-white sm:p-9" aria-labelledby="sequence-heading">
        <p class="font-mono text-xs tracking-[0.1em] text-leaf-bright uppercase">A simple sequence</p>
        <h2 id="sequence-heading" class="mt-3 font-heading text-2xl font-bold">Three steps to a first harvest.</h2>
        <ol class="mt-7 grid gap-5 md:grid-cols-3">
          <li class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-5"><strong class="block font-heading">1. Pick one crop</strong><span class="mt-2 block text-sm leading-6 text-white/[0.72]">Lettuce or herbs are the easiest start. Note how much space, light and time you really have.</span></li>
          <li class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-5"><strong class="block font-heading">2. Match a system to it</strong><span class="mt-2 block text-sm leading-6 text-white/[0.72]">Choose a method that suits the crop and your upkeep: Kratky or DWC for greens, drip or NFT for fruiting plants.</span></li>
          <li class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-5"><strong class="block font-heading">3. Measure, then adjust</strong><span class="mt-2 block text-sm leading-6 text-white/[0.72]">Check pH and EC against the sourced targets every few days and change one thing at a time.</span></li>
        </ol>
      </section>

      <aside class="mt-10 rounded-2xl border border-line bg-water-mist p-6" aria-labelledby="current-state-heading">
        <h2 id="current-state-heading" class="font-heading text-lg font-bold text-hydro-deep">Free tools for every grower</h2>
        <p class="mt-2 max-w-4xl text-sm leading-6 text-ink">Look up sourced pH and EC targets for common crops, or scale a nutrient label dose to the size of your reservoir.</p>
        <div class="mt-4 flex flex-wrap gap-4 text-sm font-bold text-hydro-teal">
          <a class="hr-focus rounded-sm underline decoration-hydro-teal/30 underline-offset-4" href="/tools/ph-ec-targets/">Open the pH & EC reference</a>
          <a class="hr-focus rounded-sm underline decoration-hydro-teal/30 underline-offset-4" href="/tools/nutrient-mixing-calculator/">Scale a label dose</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
