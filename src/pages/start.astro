---
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicSectionPath } from '../lib/sections.ts';

const decisionPaths = [
  {
    question: 'I am new to hydroponics',
    answer: 'Begin with system vocabulary, operating tradeoffs, and the constraints that shape a first setup.',
    label: 'Understand hydroponic systems',
    href: getPublicSectionPath('systems'),
  },
  {
    question: 'I need to choose a system',
    answer: 'Compare system families by space, maintenance, moving parts, crop fit, and interruption tolerance.',
    label: 'Choose a system path',
    href: getPublicSectionPath('systems'),
  },
  {
    question: 'I need to choose a crop',
    answer: 'Work from space, light, system fit, growth habit, time, and the quality of available evidence.',
    label: 'Choose a crop path',
    href: getPublicSectionPath('crops'),
  },
  {
    question: 'I need to understand nutrients or water',
    answer: 'Build context around source water, nutrient solutions, pH, EC, instruments, and interpretation limits.',
    label: 'Understand nutrients and water',
    href: getPublicSectionPath('nutrients'),
  },
  {
    question: 'I need to choose equipment',
    answer: 'Define the equipment role and evaluation criteria before looking for future product coverage.',
    label: 'Plan equipment',
    href: getPublicSectionPath('equipment'),
  },
  {
    question: 'Something is going wrong',
    answer: 'Record the symptom and system context, then prefer observable and reversible checks.',
    label: 'Start troubleshooting',
    href: getPublicSectionPath('problems'),
  },
] as const;
---
<BaseLayout title="Start Here — HydroRigor" description="A beginner-friendly decision path through HydroRigor systems, crops, nutrients, equipment, and troubleshooting.">
  <section class="py-14 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: 'Start Here', url: '/start/' },
      ]} />
      <div class="max-w-4xl">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">Beginner orientation</p>
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">Start with the decision you need to make.</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-slate">You do not need to learn every hydroponic concept at once. Choose the question closest to your situation and follow a focused path through the current site architecture.</p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {decisionPaths.map((path) => (
          <article class="flex h-full flex-col rounded-2xl border border-hydro-deep/10 bg-white p-6 shadow-[0_10px_30px_rgb(11_61_59_/_0.04)]">
            <h2 class="font-heading text-xl font-bold text-hydro-deep">{path.question}</h2>
            <p class="mt-3 grow text-sm leading-6 text-slate">{path.answer}</p>
            <a class="hr-focus mt-6 rounded-md font-bold text-hydro-teal underline decoration-hydro-teal/30 underline-offset-4" href={path.href}>{path.label} →</a>
          </article>
        ))}
      </div>

      <section class="mt-16 rounded-2xl bg-hydro-deep p-7 text-white sm:p-9" aria-labelledby="sequence-heading">
        <p class="font-mono text-xs tracking-[0.1em] text-leaf-signal uppercase">A simple sequence</p>
        <h2 id="sequence-heading" class="mt-3 font-heading text-2xl font-bold">Move from context to action.</h2>
        <ol class="mt-7 grid gap-5 md:grid-cols-3">
          <li class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-5"><strong class="block font-heading">1. Name the goal</strong><span class="mt-2 block text-sm leading-6 text-white/[0.72]">What do you want to grow or understand, and which constraints are fixed?</span></li>
          <li class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-5"><strong class="block font-heading">2. Build the system context</strong><span class="mt-2 block text-sm leading-6 text-white/[0.72]">Connect crop, method, nutrients, water, equipment, and maintenance.</span></li>
          <li class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-5"><strong class="block font-heading">3. Check the evidence</strong><span class="mt-2 block text-sm leading-6 text-white/[0.72]">Look for sources, methods, limits, and what remains unknown before acting.</span></li>
        </ol>
      </section>

      <aside class="mt-10 rounded-2xl border border-amber-measure/30 bg-mineral-sand p-6" aria-labelledby="current-state-heading">
        <h2 id="current-state-heading" class="font-heading text-lg font-bold text-hydro-deep">Current site boundary</h2>
        <p class="mt-2 max-w-4xl text-sm leading-6 text-ink">HydroRigor's search, first 25 source-backed guides, sourced five-crop pH/EC reference, and manufacturer label-dose scaler are available. Broader datasets, hands-on product testing, and named buyer recommendations remain deferred.</p>
        <div class="mt-4 flex flex-wrap gap-4 text-sm font-bold text-hydro-teal">
          <a class="hr-focus rounded-sm underline decoration-hydro-teal/30 underline-offset-4" href="/tools/ph-ec-targets/">Open the pH & EC reference</a>
          <a class="hr-focus rounded-sm underline decoration-hydro-teal/30 underline-offset-4" href="/tools/nutrient-mixing-calculator/">Scale a label dose</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
