---
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toolNavigation } from '../../lib/navigation.ts';
---
<BaseLayout
  title="Hydroponic tools — HydroRigor"
  description="Use HydroRigor's sourced pH and EC crop reference or scale a manufacturer label dose to your reservoir volume."
>
  <section class="py-14 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: 'Tools', url: '/tools/' },
      ]} />
      <div class="max-w-4xl">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">Transparent decision support</p>
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">Hydroponic tools</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-slate">Two free tools that show their sources, assumptions, units, formulas and limits instead of hiding them behind an unexplained result.</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {toolNavigation.map((tool, index) => (
          <a class="hr-focus group rounded-2xl border border-hydro-deep/10 bg-white p-7 no-underline shadow-[var(--hr-shadow-soft)] hover:border-hydro-teal/40" href={tool.href}>
            <span class="font-mono text-xs font-semibold tracking-[0.08em] text-hydro-teal uppercase">Tool {index + 1}</span>
            <span class="mt-3 block font-heading text-2xl font-bold text-hydro-deep group-hover:text-hydro-teal">{tool.label}</span>
            <span class="mt-4 block leading-7 text-slate">{tool.description}</span>
            <span class="mt-6 block text-sm font-bold text-hydro-teal">Open tool →</span>
          </a>
        ))}
      </div>

      <aside class="mt-10 rounded-2xl border border-amber-measure/30 bg-mineral-sand p-6">
        <h2 class="font-heading text-lg font-bold text-hydro-deep">What these tools do not do</h2>
        <p class="mt-2 max-w-4xl text-sm leading-6 text-slate">The target reference reports source-specific ranges. The calculator only scales a dose supplied by the user from a product label. Neither tool creates a nutrient recipe, predicts EC, diagnoses a grow, or recommends a product.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
