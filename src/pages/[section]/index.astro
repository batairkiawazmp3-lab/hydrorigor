---
import SectionLanding from '../../components/content/SectionLanding.astro';
import { sectionDefinitions, type SectionDefinition } from '../../lib/sections.ts';

export function getStaticPaths() {
  return sectionDefinitions.filter(({ id }) => id !== 'tools').map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

interface Props {
  section: SectionDefinition;
}

const { section } = Astro.props;
---
<SectionLanding section={section} />
