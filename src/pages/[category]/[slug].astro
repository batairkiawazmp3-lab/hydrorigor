---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/content/ArticleLayout.astro';
import { getSectionDefinition } from '../../lib/sections.ts';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  return entries.map((entry) => ({
    params: { category: getSectionDefinition(entry.data.category).slug, slug: entry.data.route },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout entry={entry} headings={headings}><Content /></ArticleLayout>
