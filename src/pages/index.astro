---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sectionDefinitions } from '../lib/sections.ts';

const choosePathIds = new Set(['systems', 'crops', 'nutrients', 'equipment', 'problems']);
const choosePaths = sectionDefinitions.filter(({ id }) => choosePathIds.has(id));
const evidencePaths = sectionDefinitions.filter(({ id }) => !choosePathIds.has(id));

const principles = [
  ['Source', 'Identify where a claim, specification, or future target comes from.'],
  ['Context', 'Explain the system, crop, use case, and limits around the information.'],
  ['Method', 'Show how future comparisons, tests, and tools reach their conclusions.'],
] as const;
---
<BaseLayout title="HydroRigor — Evidence-based hydroponics" description="Practical hydroponic guides, crop guidance, transparent methods, and decision paths for home growers.">
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div class="hr-container grid items-center gap-12 lg:grid-cols-[1.08fr_.92fr]">
      <div class="max-w-3xl">
        <p class="mb-5 inline-flex rounded-full border border-hydro-teal/20 bg-water-mist px-3 py-1 font-mono text-xs font-semibold tracking-[0.08em] text-hydro-deep uppercase">Evidence-led hydroponics</p>
        <h1 class="font-heading text-5xl leading-[1.02] font-extrabold tracking-[-0.055em] text-hydro-deep sm:text-6xl lg:text-7xl">Grow indoors with evidence, not guesswork.</h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate sm:text-xl">Practical hydroponic guides, crop guidance, tools, and transparent reviews—organized to show what is known, what is planned, and where evidence has limits.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="hr-focus rounded-[10px] bg-hydro-teal px-5 py-3.5 text-sm font-bold text-white no-underline transition hover:bg-hydro-deep" href="/start/">Start with hydroponics</a>
          <a class="hr-focus rounded-[10px] border border-hydro-teal/30 bg-white px-5 py-3.5 text-sm font-bold text-hydro-deep no-underline hover:border-hydro-teal" href="/search/">Search HydroRigor</a>
        </div>
      </div>

      <aside class="hr-grid-lines rounded-[28px] border border-hydro-deep/10 bg-white p-6 shadow-[var(--hr-shadow-soft)]" aria-labelledby="evidence-heading">
        <div class="rounded-2xl bg-hydro-deep p-6 text-white">
          <p class="font-mono text-xs tracking-[0.12em] text-water-mist uppercase">How to read HydroRigor</p>
          <h2 id="evidence-heading" class="mt-3 font-heading text-2xl font-bold">Evidence should remain visible.</h2>
          <dl class="mt-7 grid gap-4">
            {principles.map(([term, description]) => (
              <div class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-4">
                <dt class="font-mono text-xs font-semibold tracking-[0.08em] text-leaf-bright uppercase">{term}</dt>
                <dd class="mt-2 text-sm leading-6 text-white/[0.78]">{description}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-hydro-deep/10 bg-white py-14" aria-labelledby="start-heading">
    <div class="hr-container grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-center">
      <div>
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">Start Here</p>
        <h2 id="start-heading" class="mt-3 font-heading text-3xl font-bold tracking-[-0.035em] text-hydro-deep">Find the next useful question.</h2>
      </div>
      <div>
        <p class="text-base leading-7 text-slate">New to hydroponics? Use the static beginner path to move from goals and constraints toward systems, crops, nutrients and water, equipment, or troubleshooting.</p>
        <a class="hr-focus mt-5 inline-flex rounded-lg font-bold text-hydro-teal underline decoration-hydro-teal/30 underline-offset-4" href="/start/">Open the beginner decision path →</a>
      </div>
    </div>
  </section>

  <section class="py-20" aria-labelledby="choose-heading">
    <div class="hr-container">
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">Choose your path</p>
        <h2 id="choose-heading" class="mt-3 font-heading text-3xl font-bold tracking-[-0.035em] text-hydro-deep sm:text-4xl">Navigate by the decision in front of you.</h2>
        <p class="mt-4 leading-7 text-slate">These sections now connect to the first 25 source-backed production guides while keeping their evidence and commercial limits visible.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {choosePaths.map((section) => (
          <a class="hr-focus group rounded-2xl border border-hydro-deep/10 bg-white p-6 no-underline shadow-[0_10px_30px_rgb(11_61_59_/_0.04)] hover:border-hydro-teal/40" href={`/${section.slug}/`}>
            <span class="font-heading text-xl font-bold text-hydro-deep group-hover:text-hydro-teal">{section.navLabel}</span>
            <span class="mt-3 block text-sm leading-6 text-slate">{section.description}</span>
            <span class="mt-5 block text-sm font-bold text-hydro-teal">Explore this section →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-hydro-deep py-20 text-white" aria-labelledby="decisions-heading">
    <div class="hr-container">
      <div class="max-w-3xl">
        <p class="font-mono text-xs tracking-[0.1em] text-leaf-bright uppercase">Decision support</p>
        <h2 id="decisions-heading" class="mt-3 font-heading text-3xl font-bold tracking-[-0.035em] sm:text-4xl">See how recommendations and tools earn trust.</h2>
        <p class="mt-4 leading-7 text-white/[0.75]">A source-supported pH/EC reference, label-dose volume scaler, and the first systems, crop, nutrient, and buyer-research guides are available. Hands-on product evaluations and commercial recommendations remain unavailable.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {evidencePaths.map((section) => (
          <a class="hr-focus rounded-xl border border-white/[0.14] bg-white/[0.07] p-5 no-underline hover:bg-white/[0.12]" href={`/${section.slug}/`}>
            <span class="font-heading text-lg font-bold">{section.navLabel}</span>
            <span class="mt-3 block text-sm leading-6 text-white/[0.7]">{section.intro}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20" aria-labelledby="trust-heading">
    <div class="hr-container grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-hydro-deep/10 bg-white p-7">
        <p class="font-mono text-xs text-hydro-teal uppercase">Reviews & testing</p>
        <h2 id="trust-heading" class="mt-3 font-heading text-2xl font-bold text-hydro-deep">Evidence labels before product claims.</h2>
        <p class="mt-3 leading-7 text-slate">HydroRigor has not published hands-on product tests. Two manufacturer-documentation guides clearly identify that narrow evidence basis; the methodology still distinguishes specifications, third-party evidence, observations, and interpretation.</p>
        <a class="hr-focus mt-5 inline-flex rounded-md font-bold text-hydro-teal underline decoration-hydro-teal/30 underline-offset-4" href="/testing-methodology/">Read the testing methodology →</a>
      </div>
      <div class="rounded-2xl border border-hydro-deep/10 bg-water-mist p-7">
        <p class="font-mono text-xs text-hydro-teal uppercase">Editorial standards</p>
        <h2 class="mt-3 font-heading text-2xl font-bold text-hydro-deep">Sourcing, corrections, and incentives stay visible.</h2>
        <p class="mt-3 leading-7 text-slate">Every guide lists its sources. There are no affiliate links on HydroRigor yet; if a page ever earns from a link, it will say so clearly, and that will never decide a recommendation.</p>
        <div class="mt-5 flex flex-wrap gap-4">
          <a class="hr-focus rounded-md font-bold text-hydro-teal underline decoration-hydro-teal/30 underline-offset-4" href="/editorial-policy/">Editorial policy</a>
          <a class="hr-focus rounded-md font-bold text-hydro-teal underline decoration-hydro-teal/30 underline-offset-4" href="/affiliate-disclosure/">Affiliate disclosure</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
