---
import BaseLayout from '../layouts/BaseLayout.astro';

const metrics = [
  ['pH', '6.0', 'Target ranges will be source-backed'],
  ['EC', '1.4', 'Measurements use a dedicated data style'],
  ['JS', '~0', 'Static-first by default'],
];
---
<BaseLayout title="HydroRigor — Evidence-based hydroponics" description="HydroRigor is an evidence-based hydroponics resource for home growers.">
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div class="hr-container grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="max-w-3xl">
        <p class="mb-5 inline-flex rounded-full border border-hydro-teal/20 bg-water-mist px-3 py-1 font-mono text-xs font-semibold tracking-[0.08em] text-hydro-deep uppercase">Measured naturalism · M01 foundation</p>
        <h1 class="font-heading text-5xl leading-[1.02] font-extrabold tracking-[-0.055em] text-hydro-deep sm:text-6xl lg:text-7xl">Grow indoors with evidence, not guesswork.</h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate sm:text-xl">HydroRigor will combine practical hydroponic guides, crop targets, calculators, and transparent system reviews—built around measurements and clear sourcing.</p>
        <div id="start" class="mt-9 flex flex-wrap gap-3">
          <a class="hr-focus rounded-[10px] bg-hydro-teal px-5 py-3.5 text-sm font-bold text-white no-underline transition hover:bg-hydro-deep" href="#systems">Start with hydroponics</a>
          <a class="hr-focus rounded-[10px] border border-hydro-teal/30 bg-white px-5 py-3.5 text-sm font-bold text-hydro-deep no-underline hover:border-hydro-teal" href="#about">How HydroRigor works</a>
        </div>
      </div>

      <div class="hr-grid-lines rounded-[28px] border border-hydro-deep/10 bg-white p-6 shadow-[var(--hr-shadow-soft)]">
        <div class="rounded-2xl bg-hydro-deep p-6 text-white">
          <div class="flex items-center justify-between gap-4">
            <span class="font-mono text-xs tracking-[0.12em] text-water-mist uppercase">Root-zone snapshot</span>
            <span class="rounded-full bg-white/10 px-2.5 py-1 font-mono text-xs">prototype</span>
          </div>
          <div class="mt-8 grid grid-cols-3 gap-3">
            {metrics.map(([label, value, note]) => (
              <div class="rounded-xl border border-white/[0.12] bg-white/[0.07] p-4">
                <p class="font-mono text-xs text-water-mist">{label}</p>
                <p class="mt-1 font-mono text-2xl font-semibold">{value}</p>
                <p class="mt-3 text-xs leading-5 text-white/[0.68]">{note}</p>
              </div>
            ))}
          </div>
          <div class="mt-6 h-28 rounded-xl bg-[linear-gradient(180deg,rgba(234,244,241,.16),rgba(111,168,107,.08))] p-4">
            <svg class="h-full w-full" viewBox="0 0 420 90" role="img" aria-label="Abstract root-zone measurement line">
              <path d="M4 58 C 54 55, 75 31, 120 39 S 180 70, 222 46 S 300 27, 416 34" fill="none" stroke="#6FA86B" stroke-width="3" stroke-linecap="round" />
              <path d="M4 65H416" stroke="rgba(234,244,241,.28)" stroke-width="1" stroke-dasharray="5 7" />
              <circle cx="222" cy="46" r="5" fill="#C9872D" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-hydro-deep/10 bg-white py-8" aria-label="HydroRigor topic areas">
    <div class="hr-container grid gap-4 text-center sm:grid-cols-2 lg:grid-cols-5">
      {['Systems', 'Crops', 'pH & EC', 'Calculators', 'Reviews'].map((item) => (
        <div class="rounded-xl bg-water-mist/55 px-4 py-4 font-heading text-sm font-bold text-hydro-deep">{item}</div>
      ))}
    </div>
  </section>

  <section class="py-20" id="systems">
    <div class="hr-container">
      <div class="hr-reading">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">Choose a path</p>
        <h2 class="mt-3 font-heading text-3xl font-bold tracking-[-0.035em] text-hydro-deep sm:text-4xl">A foundation designed for decisions.</h2>
        <p class="mt-4 text-base leading-7 text-slate">M01 establishes the visual shell only. The real content engine, data collections, review schema, and tools arrive in later milestones.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {[
          ['Choose a system', 'DWC, NFT, Kratky, vertical and smart indoor systems.'],
          ['Grow a crop', 'Strawberries, lettuce, tomatoes, herbs and more.'],
          ['Fix a problem', 'pH, EC, roots, algae, lighting and nutrient diagnostics.'],
          ['Use a tool', 'Sourced target charts and transparent calculators.'],
        ].map(([title, copy]) => (
          <article class="rounded-[14px] border border-hydro-deep/10 bg-white p-6 shadow-[0_10px_30px_rgb(11_61_59_/_0.05)]">
            <div class="mb-5 h-2 w-14 rounded-full bg-leaf-signal"></div>
            <h3 class="font-heading text-xl font-bold text-hydro-deep">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="crops" class="bg-hydro-deep py-20 text-white">
    <div class="hr-container grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
      <div>
        <p class="font-mono text-xs tracking-[0.1em] text-leaf-signal uppercase">Evidence layer</p>
        <h2 class="mt-3 font-heading text-3xl font-bold tracking-[-0.035em] sm:text-4xl">Every number needs a provenance trail.</h2>
      </div>
      <div class="rounded-2xl border border-white/[0.12] bg-white/[0.07] p-6">
        <p class="text-base leading-7 text-white/[0.78]">HydroRigor’s later crop targets and calculators will distinguish measured HydroRigor data, manufacturer specifications, third-party evidence, and editorial interpretation instead of mixing them together.</p>
      </div>
    </div>
  </section>

  <section id="tools" class="py-20">
    <div class="hr-container grid gap-6 lg:grid-cols-2">
      <div class="rounded-[18px] border border-hydro-deep/10 bg-white p-7">
        <p class="font-mono text-xs text-hydro-teal uppercase">Future tool</p>
        <h2 class="mt-3 font-heading text-2xl font-bold text-hydro-deep">pH & EC target chart</h2>
        <p class="mt-3 leading-7 text-slate">Structured crop targets will power a source-linked reference rather than a static infographic.</p>
      </div>
      <div class="rounded-[18px] border border-hydro-deep/10 bg-water-mist p-7">
        <p class="font-mono text-xs text-hydro-teal uppercase">Future tool</p>
        <h2 class="mt-3 font-heading text-2xl font-bold text-hydro-deep">Nutrient mixing calculator</h2>
        <p class="mt-3 leading-7 text-slate">Calculator formulas will be tested independently, with assumptions and source data visible to readers.</p>
      </div>
    </div>
  </section>

  <section id="about" class="pb-24">
    <div class="hr-container rounded-[20px] border border-hydro-deep/10 bg-white p-8 sm:p-10">
      <p class="font-mono text-xs tracking-[0.1em] text-hydro-teal uppercase">M01 scope boundary</p>
      <h2 class="mt-3 font-heading text-3xl font-bold tracking-[-0.035em] text-hydro-deep">Foundation first.</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate">This preview intentionally contains no affiliate links, no claims of hands-on product testing, no live prices, no real crop-target dataset, and no production analytics. Those belong to later approved milestones.</p>
    </div>
  </section>
</BaseLayout>
