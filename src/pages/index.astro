---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { photos, photographerUrl, UNSPLASH_URL, type PhotoKey } from '../data/photos.ts';
import { getM06Path, m06ContentItems } from '../data/m06-content.ts';
import { sectionDefinitions } from '../lib/sections.ts';
import { EMPTY_SECTION_PATHS } from '../lib/indexing.ts';
import { readingMinutes } from '../lib/reading.ts';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const byRoute = new Map(articles.map((entry) => [entry.data.route, entry]));
const item = (route: string) => m06ContentItems.find((candidate) => candidate.route === route)!;

const crops: Array<{ route: string; label: string; note: string; photo: PhotoKey }> = [
  { route: 'hydroponic-lettuce', label: 'Lettuce & greens', note: 'The easiest first crop for any system', photo: 'butterhead-lettuce-hands' },
  { route: 'hydroponic-strawberries', label: 'Strawberries', note: 'Day-neutral varieties fruit for months', photo: 'strawberries-gutter' },
  { route: 'hydroponic-tomatoes', label: 'Tomatoes', note: 'Big plants with big light needs', photo: 'tomatoes-high-wire' },
  { route: 'hydroponic-nutrients', label: 'Nutrients & water', note: 'pH, EC and mixing, explained', photo: 'meter-probe' },
];

const topics = sectionDefinitions.filter((section) => !EMPTY_SECTION_PATHS.has(`/${section.slug}/`));

const featured: Array<{ route: string; photo: PhotoKey; tag: string }> = [
  { route: 'deep-water-culture-hydroponics', photo: 'dwc-net-pot-roots', tag: 'Systems' },
  { route: 'hydroponic-lettuce-systems', photo: 'lettuce-channel-net-pot', tag: 'Crops' },
  { route: 'how-to-mix-hydroponic-nutrients', photo: 'beaker-measure', tag: 'Nutrients' },
];

const heroKeys: PhotoKey[] = ['systems-home-nft-lights-tall', 'strawberries-hanging-close'];
const usedKeys = [...new Set<PhotoKey>([...heroKeys, ...crops.map((crop) => crop.photo), ...featured.map((feature) => feature.photo)])];
const credits = [...new Map(usedKeys.map((key) => [photos[key].username, photos[key]])).values()];
---
<BaseLayout title="HydroRigor — Evidence-based hydroponics for home growers" description="Clear hydroponic guides for home growers: sourced pH, EC, light and temperature targets, the systems worth buying, and fixes for common problems.">
  <section class="py-14 sm:py-20" aria-labelledby="hero-heading">
    <div class="hr-container grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="mb-6 inline-flex items-center gap-2 rounded-full bg-water-mist px-3.5 py-1.5 text-sm font-semibold text-hydro-emerald-dark">
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
          Every target sourced to university research
        </p>
        <h1 id="hero-heading" class="font-heading text-[2.6rem] leading-[1.02] font-extrabold tracking-[-0.04em] text-hydro-deep sm:text-6xl lg:text-[4.1rem]">Grow indoors with evidence, not guesswork.</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate">Clear hydroponic guides for home growers: the exact pH, EC, light and temperature targets, the systems worth buying, and what to do when plants struggle.</p>
        <form class="mt-8 flex max-w-xl flex-wrap gap-3" role="search" action="/search/" method="get">
          <label class="sr-only" for="home-search">Search HydroRigor guides</label>
          <input id="home-search" name="q" type="search" placeholder="Try “strawberries pH” or “DWC”" class="hr-focus min-h-13 flex-[1_1_16rem] rounded-full border-[1.5px] border-line bg-white px-5 text-base text-ink placeholder:text-slate/70" />
          <button type="submit" class="hr-focus min-h-13 rounded-full bg-hydro-deep px-6 font-semibold text-white hover:bg-hydro-teal">Search</button>
        </form>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold">
          <a class="hr-focus rounded-sm text-hydro-teal" href="/start/">New to hydroponics? Start here →</a>
          <a class="hr-focus rounded-sm text-hydro-teal" href="/tools/">Free tools →</a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3.5">
        <a class="hr-focus group relative row-span-2 min-h-[26rem] overflow-hidden rounded-[1.75rem] no-underline" href={getM06Path(item('indoor-hydroponic-systems-for-home'))}>
          <Photo photo={photos['systems-home-nft-lights-tall']} decorative eager sizes="(min-width: 1024px) 270px, 50vw" widths={[320, 480, 640, 960]} class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
          <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-hydro-deep/45 via-transparent to-transparent"></span>
          <span class="absolute inset-x-4 bottom-4 rounded-2xl bg-white/[0.94] p-4">
            <span class="block font-mono text-[0.7rem] font-bold tracking-[0.1em] text-hydro-teal uppercase">Systems</span>
            <span class="mt-1 block font-heading font-bold leading-tight text-hydro-deep">Indoor hydroponic systems for home</span>
          </span>
        </a>
        <a class="hr-focus group relative min-h-[12.5rem] overflow-hidden rounded-[1.75rem] no-underline" href={getM06Path(item('hydroponic-strawberries'))}>
          <Photo photo={photos['strawberries-hanging-close']} decorative sizes="(min-width: 1024px) 270px, 50vw" widths={[320, 480, 640]} class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
          <span class="absolute bottom-3 left-3 rounded-full bg-white/[0.94] px-3 py-1.5 text-sm font-bold text-hydro-deep">Strawberries</span>
        </a>
        <div class="flex min-h-[12.5rem] flex-col justify-between rounded-[1.75rem] bg-hydro-deep p-5">
          <p class="font-mono text-[0.7rem] font-bold tracking-[0.12em] text-leaf-bright uppercase">Sourced target</p>
          <p class="text-white"><span class="block text-sm font-semibold text-white/[0.75]">Strawberries</span><span class="block font-mono text-xl leading-tight font-bold sm:text-3xl">pH 5.5–6.0</span></p>
          <a class="hr-focus rounded-sm text-sm font-semibold text-leaf-bright" href="/tools/ph-ec-targets/">All crop targets →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16" aria-labelledby="grow-heading">
    <div class="hr-container">
      <h2 id="grow-heading" class="font-heading text-3xl font-extrabold tracking-[-0.025em] text-hydro-deep">What do you want to grow?</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {crops.map((crop) => (
          <a class="hr-focus group overflow-hidden rounded-[1.4rem] border border-line bg-white no-underline transition hover:-translate-y-0.5 hover:shadow-[var(--hr-shadow-soft)]" href={getM06Path(item(crop.route))}>
            <span class="block h-44 overflow-hidden">
              <Photo photo={photos[crop.photo]} decorative sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw" widths={[320, 480, 640, 800]} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
            </span>
            <span class="block p-5">
              <span class="block font-heading text-lg font-bold text-hydro-deep group-hover:text-hydro-teal">{crop.label}</span>
              <span class="mt-1 block text-sm text-slate">{crop.note}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16" aria-labelledby="topics-heading">
    <div class="hr-container">
      <h2 id="topics-heading" class="font-heading text-xl font-extrabold text-hydro-deep">Browse by topic</h2>
      <ul class="mt-4 flex flex-wrap gap-2.5">
        {topics.map((section) => (
          <li><a class="hr-focus inline-flex min-h-11 items-center rounded-full border border-line bg-white px-4 text-sm font-semibold text-hydro-deep no-underline hover:border-hydro-teal hover:text-hydro-teal" href={`/${section.slug}/`}>{section.navLabel}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-hydro-deep py-16 text-white sm:py-20" aria-labelledby="guides-heading">
    <div class="hr-container">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="guides-heading" class="font-heading text-3xl font-extrabold tracking-[-0.025em]">Start with these guides</h2>
        <a class="hr-focus rounded-sm font-semibold text-leaf-bright" href="/start/">Find your path →</a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {featured.map((feature) => {
          const meta = item(feature.route);
          const entry = byRoute.get(feature.route);
          return (
            <a class="hr-focus group overflow-hidden rounded-[1.4rem] bg-night-panel no-underline" href={getM06Path(meta)}>
              <span class="block h-52 overflow-hidden">
                <Photo photo={photos[feature.photo]} decorative sizes="(min-width: 768px) 33vw, 100vw" widths={[400, 640, 960]} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
              </span>
              <span class="block p-6">
                <span class="text-sm font-semibold text-leaf-bright">{feature.tag} · {readingMinutes(entry?.body)} min read</span>
                <span class="mt-2 block font-heading text-xl leading-snug font-bold text-white">{meta.title}</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20" aria-labelledby="tools-heading">
    <div class="hr-container grid gap-5 lg:grid-cols-2">
      <div class="rounded-[1.75rem] bg-water-mist p-8">
        <p class="font-mono text-xs font-bold tracking-[0.12em] text-hydro-emerald-dark uppercase">Free tools</p>
        <h2 id="tools-heading" class="mt-3 font-heading text-[1.75rem] leading-tight font-extrabold text-hydro-deep">Mix nutrients and check targets in seconds</h2>
        <p class="mt-3 leading-7 text-slate">Scale any nutrient label dose to your reservoir and look up sourced pH and EC ranges for each crop.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="hr-focus inline-flex min-h-11 items-center rounded-full bg-hydro-teal px-5 text-sm font-semibold text-white no-underline hover:bg-hydro-emerald-dark" href="/tools/nutrient-mixing-calculator/">Nutrient calculator</a>
          <a class="hr-focus inline-flex min-h-11 items-center rounded-full border-[1.5px] border-hydro-teal px-5 text-sm font-semibold text-hydro-teal no-underline" href="/tools/ph-ec-targets/">pH &amp; EC targets</a>
        </div>
      </div>
      <div class="rounded-[1.75rem] border border-line bg-white p-8">
        <p class="font-mono text-xs font-bold tracking-[0.12em] text-slate uppercase">Why trust HydroRigor</p>
        <h2 class="mt-3 font-heading text-[1.75rem] leading-tight font-extrabold text-hydro-deep">Run by a scientist. Every target cited.</h2>
        <p class="mt-3 leading-7 text-slate">Najeeb checks each guide against university and extension research and lists every source. There are no affiliate links on HydroRigor yet; if a page ever earns from a link, it will say so clearly, and that will never decide a recommendation.</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-semibold">
          <a class="hr-focus rounded-sm text-hydro-teal" href="/about/">About Najeeb</a>
          <a class="hr-focus rounded-sm text-hydro-teal" href="/editorial-policy/">Editorial policy</a>
          <a class="hr-focus rounded-sm text-hydro-teal" href="/testing-methodology/">Testing methodology</a>
        </div>
      </div>
    </div>
    <div class="hr-container mt-10">
      <p class="text-xs leading-5 text-slate" data-pagefind-ignore>
        Photos by {credits.map((credit, index) => (
          <>{index > 0 && (index === credits.length - 1 ? ' and ' : ', ')}<a class="hr-focus rounded-sm text-slate underline decoration-line underline-offset-2 hover:text-hydro-teal" href={photographerUrl(credit.username)} rel="noopener">{credit.photographer}</a></>
        ))} on <a class="hr-focus rounded-sm text-slate underline decoration-line underline-offset-2 hover:text-hydro-teal" href={UNSPLASH_URL} rel="noopener">Unsplash</a>.
      </p>
    </div>
  </section>
</BaseLayout>
