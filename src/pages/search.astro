---
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Search — HydroRigor"
  description="Search HydroRigor's public guides, section architecture, and editorial standards."
  noindex={true}
>
  <section class="py-14 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: 'Search', url: '/search/' },
      ]} />
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">Static site search</p>
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">Search HydroRigor</h1>
        <p class="mt-5 text-lg leading-8 text-slate">Search the public homepage, beginner path, section landings, and trust pages. Draft development fixtures and this results page are excluded from the index.</p>
      </div>

      <form id="site-search" class="mt-10 max-w-3xl rounded-2xl border border-hydro-deep/10 bg-white p-5 shadow-[var(--hr-shadow-soft)]" role="search" action="/search/" method="get">
        <label class="font-heading text-base font-bold text-hydro-deep" for="search-query">Search terms</label>
        <p id="search-help" class="mt-1 text-sm leading-6 text-slate">Try a topic such as “hydroponic systems,” “beginner,” or “editorial policy.”</p>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <input
            id="search-query"
            class="hr-focus min-w-0 grow rounded-lg border border-hydro-deep/20 bg-white px-4 py-3 text-base text-ink"
            type="search"
            name="q"
            autocomplete="off"
            aria-describedby="search-help search-status"
            aria-controls="search-results"
          />
          <button class="hr-focus rounded-lg bg-hydro-teal px-5 py-3 font-bold text-white hover:bg-hydro-deep" type="submit">Search</button>
        </div>
      </form>

      <div class="mt-8 max-w-4xl">
        <p id="search-status" class="text-sm font-semibold text-slate" role="status" aria-live="polite" aria-atomic="true">Enter a search term to begin.</p>
        <ol id="search-results" class="mt-5 grid gap-4" aria-label="Search results"></ol>
        <noscript><p class="mt-5 rounded-xl border border-amber-measure/30 bg-mineral-sand p-5 text-sm leading-6">Static search requires JavaScript on this page. All other M03 navigation remains available without JavaScript.</p></noscript>
      </div>
    </div>
  </section>

  <script is:inline type="module">
    const form = document.querySelector('#site-search');
    const input = document.querySelector('#search-query');
    const status = document.querySelector('#search-status');
    const results = document.querySelector('#search-results');
    let pagefindPromise;

    const loadPagefind = async () => {
      pagefindPromise ??= import('/pagefind/pagefind.js').then(async (pagefind) => {
        await pagefind.init();
        return pagefind;
      });
      return pagefindPromise;
    };

    const clearResults = () => results.replaceChildren();

    const renderResult = (result) => {
      const item = document.createElement('li');
      item.className = 'rounded-2xl border border-hydro-deep/10 bg-white p-6 shadow-[0_10px_30px_rgb(11_61_59_/_0.04)]';

      const link = document.createElement('a');
      link.className = 'hr-focus rounded-md font-heading text-xl font-bold text-hydro-deep no-underline hover:text-hydro-teal';
      link.href = result.url;
      link.textContent = result.meta?.title || result.url;

      const excerpt = document.createElement('p');
      excerpt.className = 'mt-3 text-sm leading-6 text-slate';
      excerpt.textContent = result.plain_excerpt || 'Open this page to read more.';

      item.append(link, excerpt);
      return item;
    };

    const runSearch = async (rawQuery) => {
      const query = rawQuery.trim();
      clearResults();

      if (!query) {
        status.textContent = 'Enter a search term to begin.';
        return;
      }

      status.textContent = `Searching for “${query}”…`;

      try {
        const pagefind = await loadPagefind();
        const response = await pagefind.search(query);
        const loaded = await Promise.all(response.results.slice(0, 20).map((result) => result.data()));

        if (loaded.length === 0) {
          status.textContent = `No results found for “${query}”. Try a broader topic or use Start Here.`;
          return;
        }

        status.textContent = `${loaded.length} result${loaded.length === 1 ? '' : 's'} for “${query}”.`;
        results.append(...loaded.map(renderResult));
      } catch {
        status.textContent = 'Search could not load. Use the topic navigation or try again after the static site build completes.';
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
      runSearch(query);
    });

    input.addEventListener('focus', () => { void loadPagefind(); }, { once: true });

    const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
    if (initialQuery) {
      input.value = initialQuery;
      runSearch(initialQuery);
    }
  </script>
</BaseLayout>
