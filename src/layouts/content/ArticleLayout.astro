---
import { pageTitle } from '../../lib/seo.ts';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import CommercialDisclosure from '../../components/commercial/CommercialDisclosure.astro';
import MerchantDestinations from '../../components/commercial/MerchantDestinations.astro';
import EvidenceBasis from '../../components/commercial/EvidenceBasis.astro';
import AuthorBio from '../../components/content/AuthorBio.astro';
import ContentProse from '../../components/content/ContentProse.astro';
import DevelopmentNotice from '../../components/content/DevelopmentNotice.astro';
import PublicationMeta from '../../components/content/PublicationMeta.astro';
import SourcesList from '../../components/content/SourcesList.astro';
import EmailSignup from '../../components/newsletter/EmailSignup.astro';
import Photo from '../../components/Photo.astro';
import PhotoCredit from '../../components/PhotoCredit.astro';
import { photoForGuide } from '../../data/photos.ts';
import { brandedShareImage, pinImagePath, schemaImages } from '../../lib/social-image.ts';
import { absoluteUrl } from '../../lib/site.ts';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { resolveCommercialPageState } from '../../lib/commercial/registry.ts';
import { getSectionDefinition } from '../../lib/sections.ts';
import { buildArticleJsonLd } from '../../lib/structured-data.ts';
import { readingMinutes } from '../../lib/reading.ts';
import { contentItems, getContentPath } from '../../data/content-manifest.ts';
import BaseLayout from '../BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;
const { data } = entry;
const section = getSectionDefinition(data.category);
const pathname = `/${section.slug}/${data.route}/`;
const heroPhoto = data.hero ? undefined : photoForGuide(data.route);
const articleJsonLd = buildArticleJsonLd({
  image: data.hero ? [data.hero.src] : await schemaImages(heroPhoto),
  headline: data.title,
  description: data.description,
  url: data.canonical ?? pathname,
  author: data.author,
  publishDate: data.publishDate,
  updatedDate: data.updatedDate,
  reviewer: data.reviewer,
});
const inManifest = contentItems.some((item) => item.route === data.route);
const image = data.hero
  ? { src: data.hero.src, alt: data.hero.alt }
  : inManifest ? brandedShareImage(data.route, data.title, heroPhoto) : undefined;
const commercialState = resolveCommercialPageState(data);
const minutes = readingMinutes(entry.body);
const toc = headings.filter(({ depth }) => depth === 2);

const related = contentItems
  .filter((item) => item.collection === 'articles' && item.category === data.category && item.route !== data.route)
  .slice(0, 4);
---
<BaseLayout
  title={pageTitle(data.title)}
  description={data.description}
  canonical={data.canonical}
  noindex={data.draft}
  type="article"
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  image={image}
  jsonLd={articleJsonLd}
>
  <article class="pt-8 pb-16 sm:pt-12">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: section.title, url: `/${section.slug}/` },
        { name: data.title, url: pathname },
      ]} />
      <div class="max-w-4xl">
        <DevelopmentNotice draft={data.draft} />
        <h1 class="mt-2 font-heading text-[2rem] leading-[1.06] font-extrabold tracking-[-0.035em] text-hydro-deep sm:text-5xl lg:text-[3.35rem]">{data.title}</h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate sm:mt-5 sm:text-lg sm:leading-8">{data.description}</p>
        <div class="mt-4 sm:mt-6">
          <PublicationMeta compact author={data.author} publishDate={data.publishDate} updatedDate={data.updatedDate} reviewer={data.reviewer}>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            <span aria-hidden="true">·</span>
            <span>{data.sources.length} {data.sources.length === 1 ? 'source' : 'sources'} cited</span>
          </PublicationMeta>
        </div>
      </div>

      {data.hero && (
        <div class="mt-8 overflow-hidden rounded-[1.75rem]">
          <img class="h-auto w-full" src={data.hero.src} alt={data.hero.alt} width={data.hero.width} height={data.hero.height} />
        </div>
      )}
      {heroPhoto && (
        <figure class="mt-6 sm:mt-8" data-pagefind-ignore="all">
          <div class="aspect-[16/9] overflow-hidden rounded-[1.75rem] bg-water-mist sm:aspect-[21/9]">
            <Photo photo={heroPhoto} eager pinMedia={inManifest ? absoluteUrl(pinImagePath(data.route)) : undefined} sizes="(min-width: 1232px) 1200px, calc(100vw - 2rem)" class="h-full w-full object-cover" />
          </div>
          <figcaption><PhotoCredit photo={heroPhoto} class="mt-2" /></figcaption>
        </figure>
      )}

      <div class="mt-10 grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-14">
        <aside class="lg:order-none" aria-label="On this page">
          {toc.length > 0 && (
            <>
              <details class="group rounded-2xl border border-line bg-white lg:hidden">
                <summary class="hr-focus flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-2xl px-5 font-mono text-xs font-bold tracking-[0.12em] text-slate uppercase [&::-webkit-details-marker]:hidden">
                  On this page ({toc.length} sections)
                  <svg aria-hidden="true" class="h-4 w-4 text-hydro-teal transition group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4" /></svg>
                </summary>
                <ol class="grid gap-2 px-5 pb-5 text-sm leading-5">
                  {toc.map((heading) => (
                    <li><a class="hr-focus rounded-sm text-hydro-deep no-underline hover:text-hydro-teal" href={`#${heading.slug}`}>{heading.text}</a></li>
                  ))}
                </ol>
              </details>
              <nav class="hidden rounded-2xl border border-line bg-white p-5 lg:sticky lg:top-24 lg:block" aria-labelledby="toc-heading">
                <p id="toc-heading" class="font-mono text-xs font-bold tracking-[0.12em] text-slate uppercase">On this page</p>
                <ol class="mt-3 grid gap-2 text-sm leading-5">
                  {toc.map((heading) => (
                    <li><a class="hr-focus rounded-sm text-hydro-deep no-underline hover:text-hydro-teal" href={`#${heading.slug}`}>{heading.text}</a></li>
                  ))}
                </ol>
              </nav>
            </>
          )}
        </aside>

        <div class="hr-reading min-w-0">
          <CommercialDisclosure
            affiliateDisclosure={data.affiliateDisclosure}
            affiliateDestinationCount={commercialState.affiliateDestinations.length}
            affiliateDisclosureReason={data.affiliateDisclosureReason}
          />
          {data.commercialResearch && (
            <>
              <EvidenceBasis basis={data.commercialResearch.evidenceBasis} />
              <p class="mt-3 rounded-xl border border-line bg-white p-4 text-sm leading-6 text-slate">
                <strong class="text-hydro-deep">Selection scope:</strong> {data.commercialResearch.scope}
              </p>
            </>
          )}
          {commercialState.destinations.length > 0 && (
            <MerchantDestinations destinationIds={commercialState.destinations.map(({ id }) => id)} />
          )}
          <ContentProse><slot /></ContentProse>
          <AuthorBio name={data.author} />
          <SourcesList sources={data.sources} />
          <EmailSignup id="guide-signup" class="mt-14" />

          {related.length > 0 && (
            <section class="mt-14" aria-labelledby="related-heading">
              <h2 id="related-heading" class="font-heading text-2xl font-extrabold tracking-[-0.02em] text-hydro-deep">Keep reading</h2>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {related.map((item) => {
                  const relatedPhoto = photoForGuide(item.route);
                  return (
                    <a class="hr-focus group flex items-stretch overflow-hidden rounded-[1.2rem] border border-line bg-white no-underline transition hover:border-hydro-teal" href={getContentPath(item)}>
                      {relatedPhoto && (
                        <span class="block w-28 shrink-0 overflow-hidden bg-water-mist sm:w-32">
                          <Photo photo={relatedPhoto} decorative sizes="128px" widths={[160, 320]} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.05]" />
                        </span>
                      )}
                      <span class="block p-4">
                        <span class="text-sm font-semibold text-hydro-teal">{section.navLabel}</span>
                        <span class="mt-1 block font-heading font-bold leading-snug text-hydro-deep group-hover:text-hydro-teal">{item.title}</span>
                      </span>
                    </a>
                  );
                })}
              </div>
            </section>
          )}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
