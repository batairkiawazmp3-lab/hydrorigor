---
import { pageTitle } from '../../lib/seo.ts';
import type { CollectionEntry } from 'astro:content';
import CommercialDisclosure from '../../components/commercial/CommercialDisclosure.astro';
import EvidenceBasis from '../../components/commercial/EvidenceBasis.astro';
import EvidenceClaims from '../../components/commercial/EvidenceClaims.astro';
import MerchantDestinations from '../../components/commercial/MerchantDestinations.astro';
import ProductIdentity from '../../components/commercial/ProductIdentity.astro';
import ContentProse from '../../components/content/ContentProse.astro';
import DevelopmentNotice from '../../components/content/DevelopmentNotice.astro';
import PublicationMeta from '../../components/content/PublicationMeta.astro';
import SourcesList from '../../components/content/SourcesList.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import PhotoCredit from '../../components/PhotoCredit.astro';
import { photoForGuide } from '../../data/photos.ts';
import { brandedShareImage, pinImagePath } from '../../lib/social-image.ts';
import { contentItems } from '../../data/content-manifest.ts';
import { absoluteUrl } from '../../lib/site.ts';
import {
  assertProductEvidenceBasis,
  resolveCommercialPageState,
  resolveProductRecord,
} from '../../lib/commercial/registry.ts';
import { buildCommercialReviewJsonLd } from '../../lib/commercial/structured-data.ts';
import BaseLayout from '../BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'reviews'>;
}

const { entry } = Astro.props;
const { data } = entry;
const pathname = `/reviews/${data.route}/`;
const product = resolveProductRecord(data.productId, data.draft);
assertProductEvidenceBasis(product, data.evidenceBasis);
const commercialState = resolveCommercialPageState(data);
const heroPhoto = photoForGuide(data.route);
const inManifest = contentItems.some((item) => item.route === data.route);
const image = inManifest ? brandedShareImage(data.route, data.title, heroPhoto) : undefined;
const commercialJsonLd = buildCommercialReviewJsonLd({
  product,
  headline: data.title,
  verdict: data.verdict,
  author: data.author,
  publishDate: data.publishDate,
  evidenceBasis: data.evidenceBasis,
  evidenceClaims: data.evidenceClaims,
  testedBy: data.testedBy,
  methodology: data.methodology,
  testPeriod: data.testPeriod,
  acquisitionRelationship: data.acquisitionRelationship,
  acquisitionDisclosure: data.acquisitionDisclosure,
  draft: data.draft,
  structuredDataEnabled: data.structuredDataEnabled,
});
---
<BaseLayout
  title={pageTitle(data.title)}
  description={data.description}
  canonical={data.canonical}
  noindex={data.draft}
  type="article"
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  image={image}
  jsonLd={commercialJsonLd ?? undefined}
>
  <article class="py-14 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: 'Editorial reviews', url: '/reviews/' },
        { name: data.title, url: pathname },
      ]} />
      <div class="hr-reading">
        <DevelopmentNotice draft={data.draft} />
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">Editorial review</p>
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">{data.title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate">{data.description}</p>
        <div class="mt-6"><PublicationMeta author={data.author} publishDate={data.publishDate} updatedDate={data.updatedDate} testedBy={data.testedBy} /></div>
        {heroPhoto && (
          <figure class="mt-8" data-pagefind-ignore="all">
            <div class="aspect-[21/9] overflow-hidden rounded-[1.5rem] bg-water-mist">
              <Photo photo={heroPhoto} eager pinMedia={inManifest ? absoluteUrl(pinImagePath(data.route)) : undefined} sizes="(min-width: 768px) 720px, calc(100vw - 2rem)" widths={[400, 640, 960, 1280]} class="h-full w-full object-cover" />
            </div>
            <figcaption><PhotoCredit photo={heroPhoto} class="mt-2" /></figcaption>
          </figure>
        )}
        <EvidenceBasis basis={data.evidenceBasis} />
        <EvidenceClaims claims={data.evidenceClaims} />
        <CommercialDisclosure
          affiliateDisclosure={data.affiliateDisclosure}
          affiliateDestinationCount={commercialState.affiliateDestinations.length}
          affiliateDisclosureReason={data.affiliateDisclosureReason}
          acquisitionRelationship={data.acquisitionRelationship}
          acquisitionDisclosure={data.acquisitionDisclosure}
        />
        <ProductIdentity product={product} />

        <section class="mt-10 rounded-2xl border border-hydro-deep/10 bg-water-mist p-6" aria-labelledby="verdict-heading">
          <h2 id="verdict-heading" class="font-heading text-2xl font-bold text-hydro-deep">Verdict</h2>
          <p class="mt-3 leading-7 text-ink">{data.verdict}</p>
        </section>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <section class="rounded-2xl border border-hydro-deep/10 bg-white p-6">
            <h2 class="font-heading text-xl font-bold text-hydro-deep">Pros</h2>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-slate">{data.pros.map((item) => <li>{item}</li>)}</ul>
          </section>
          <section class="rounded-2xl border border-hydro-deep/10 bg-white p-6">
            <h2 class="font-heading text-xl font-bold text-hydro-deep">Cons</h2>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-slate">{data.cons.map((item) => <li>{item}</li>)}</ul>
          </section>
        </div>

        <section class="mt-8 rounded-2xl border border-hydro-deep/10 bg-white p-6" aria-labelledby="methodology-heading">
          <h2 id="methodology-heading" class="font-heading text-xl font-bold text-hydro-deep">Methodology</h2>
          <p class="mt-3 leading-7 text-slate">{data.methodology}</p>
        </section>

        <MerchantDestinations destinationIds={commercialState.destinations.map(({ id }) => id)} />

        <div class="mt-10"><ContentProse><slot /></ContentProse></div>
        <SourcesList sources={data.sources} />
      </div>
    </div>
  </article>
</BaseLayout>
