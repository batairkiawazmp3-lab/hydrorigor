---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WebAnalytics from '../components/observability/WebAnalytics.astro';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildWebsiteJsonLd } from '../lib/structured-data.ts';
import type { SeoImage } from '../lib/seo.ts';
import { socialImage } from '../lib/social-image.ts';
import { photos } from '../data/photos.ts';

interface Props {
  title: string;
  description: string;
  canonical?: string | undefined;
  noindex?: boolean | undefined;
  type?: 'website' | 'article' | undefined;
  publishDate?: Date | string | undefined;
  updatedDate?: Date | string | undefined;
  image?: SeoImage | undefined;
  jsonLd?: object | object[] | undefined;
  omitCanonical?: boolean | undefined;
}
const { title, description, canonical, noindex, type, publishDate, updatedDate, image, jsonLd, omitCanonical } = Astro.props;
const shareImage = image ?? await socialImage(photos['systems-home-nft-lights']);
const structuredData = [buildWebsiteJsonLd(), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const searchable = !noindex;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F6B4F" />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      canonical={canonical}
      noindex={noindex}
      type={type}
      publishDate={publishDate}
      updatedDate={updatedDate}
      image={shareImage}
      omitCanonical={omitCanonical}
    />
    <JsonLd data={structuredData} />
  </head>
  <body>
    <a class="hr-focus sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1" data-pagefind-body={searchable ? true : undefined}><slot /></main>
    <SiteFooter />
    <WebAnalytics />
  </body>
</html>
