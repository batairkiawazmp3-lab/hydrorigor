---
import { pageTitle } from '../lib/seo.ts';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import BaseLayout from './BaseLayout.astro';

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  pathname: string;
  relatedLinks?: readonly RelatedLink[] | undefined;
}

const { eyebrow, title, description, pathname, relatedLinks = [] } = Astro.props;
---
<BaseLayout title={pageTitle(title)} description={description}>
  <article class="py-14 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: title, url: pathname },
      ]} />
      <header class="hr-reading">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">{eyebrow}</p>
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">{title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate">{description}</p>
      </header>

      <div class="hr-prose hr-reading mt-10"><slot /></div>

      {relatedLinks.length > 0 && (
        <aside class="mt-12 rounded-2xl border border-hydro-deep/10 bg-water-mist p-6" aria-labelledby="continue-heading">
          <h2 id="continue-heading" class="font-heading text-xl font-bold text-hydro-deep">Continue exploring</h2>
          <div class="mt-4 flex flex-wrap gap-3">
            {relatedLinks.map((item) => (
              <a class="hr-focus rounded-lg bg-white px-4 py-3 text-sm font-bold text-hydro-deep no-underline hover:text-hydro-teal" href={item.href}>{item.label}</a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
