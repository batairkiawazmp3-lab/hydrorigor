---
/**
 * Original flat illustrations in the Lab Garden palette. Presentation attributes only
 * (no inline style) so they pass the site's strict CSP. Decorative by default.
 */
export type IllustrationName =
  | 'rack' | 'strawberry' | 'lettuce' | 'tomato' | 'herbs'
  | 'systems' | 'nutrients' | 'buyer' | 'reviews' | 'tools' | 'equipment' | 'problems' | 'compare';

interface Props {
  name: IllustrationName;
  class?: string;
  label?: string;
  fit?: 'cover' | 'contain';
}

const { name, class: className, label, fit = 'cover' } = Astro.props;
const G = { night: '#0E1A14', panel: '#17271F', emerald: '#0F6B4F', leaf: '#3E9B6A', light: '#7FC48E', lime: '#C6F35E', wash: '#E3F1E8', bench: '#F5F7F2', white: '#FFFFFF', berry: '#D2453B', tomato: '#E2582F', root: '#EADFC8' };
---
<svg class:list={[className, 'overflow-hidden']} viewBox="0 0 640 400" preserveAspectRatio={fit === 'cover' ? 'xMidYMid slice' : 'xMidYMid meet'} data-pagefind-ignore role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <rect width="640" height="400" fill={['rack', 'tools', 'problems'].includes(name) ? G.panel : G.wash} />
  {name === 'rack' && (
    <g>
      <rect x="60" y="40" width="520" height="14" rx="7" fill={G.lime} />
      <path d="M90 54l-30 70M200 54l-10 70M320 54v70M440 54l10 70M550 54l30 70" stroke={G.lime} stroke-opacity="0.18" stroke-width="40" />
      {[150, 270].map((y) => (
        <g>
          <rect x="40" y={y} width="560" height="26" rx="13" fill={G.bench} />
          {[90, 170, 250, 330, 410, 490, 560].map((x) => (
            <g>
              <ellipse cx={x} cy={y - 18} rx="34" ry="24" fill={G.leaf} />
              <ellipse cx={x - 14} cy={y - 26} rx="18" ry="14" fill={G.light} />
              <ellipse cx={x + 14} cy={y - 24} rx="16" ry="12" fill={G.emerald} />
            </g>
          ))}
        </g>
      ))}
      <path d="M70 330v40M570 330v40" stroke={G.bench} stroke-width="10" stroke-linecap="round" />
      <circle cx="600" cy="300" r="6" fill={G.lime} /><circle cx="610" cy="318" r="4" fill={G.lime} />
    </g>
  )}
  {name === 'strawberry' && (
    <g>
      <rect x="290" y="40" width="60" height="340" rx="18" fill={G.bench} />
      {[90, 170, 250, 330].map((y, i) => (
        <g>
          <path d={`M${i % 2 ? 350 : 290} ${y}c${i % 2 ? 60 : -60} -40 ${i % 2 ? 120 : -120} -10 ${i % 2 ? 130 : -130} 30`} fill="none" stroke={G.leaf} stroke-width="6" />
          <ellipse cx={i % 2 ? 420 : 220} cy={y - 34} rx="44" ry="26" fill={G.leaf} />
          <path d={`M${i % 2 ? 470 : 170} ${y + 6}c-14 0 -22 14 -14 30c6 12 14 18 14 18s8-6 14-18c8-16 0-30-14-30z`} fill={G.berry} />
          <path d={`M${i % 2 ? 462 : 162} ${y + 6}l8 -8l8 8`} fill="none" stroke={G.emerald} stroke-width="4" stroke-linecap="round" />
        </g>
      ))}
    </g>
  )}
  {name === 'lettuce' && (
    <g>
      <rect x="120" y="290" width="400" height="70" rx="20" fill={G.bench} />
      <ellipse cx="320" cy="240" rx="170" ry="90" fill={G.emerald} />
      <ellipse cx="250" cy="215" rx="100" ry="70" fill={G.leaf} />
      <ellipse cx="390" cy="215" rx="100" ry="70" fill={G.leaf} />
      <ellipse cx="320" cy="190" rx="90" ry="70" fill={G.light} />
      <path d="M320 140v110M280 170l40 40 40-40" fill="none" stroke={G.wash} stroke-width="5" stroke-linecap="round" />
      <path d="M270 360v30M320 360v36M370 360v30" stroke={G.root} stroke-width="5" stroke-linecap="round" />
    </g>
  )}
  {name === 'tomato' && (
    <g>
      <path d="M200 400V60M440 400V60" stroke={G.root} stroke-width="8" />
      <path d="M320 400c0-90 -40-150 0-250c30-70 10-110 0-110" fill="none" stroke={G.leaf} stroke-width="10" />
      {([[250, 120], [400, 170], [240, 260]] as [number, number][]).map(([x, y]) => <ellipse cx={x} cy={y} rx="56" ry="28" fill={G.leaf} />)}
      {([[360, 250, 34], [310, 300, 30], [390, 320, 26], [280, 200, 24]] as [number, number, number][]).map(([x, y, r]) => (
        <g><circle cx={x} cy={y} r={r} fill={G.tomato} /><path d={`M${x - 8} ${y - r + 2}l8 6l8 -6`} fill="none" stroke={G.emerald} stroke-width="4" stroke-linecap="round" /></g>
      ))}
    </g>
  )}
  {name === 'herbs' && (
    <g>
      <rect x="180" y="280" width="280" height="90" rx="24" fill={G.bench} />
      <path d="M320 290V120" stroke={G.emerald} stroke-width="8" />
      {([[270, 170, -30], [370, 150, 30], [260, 240, -25], [380, 225, 25], [320, 105, 0]] as [number, number, number][]).map(([x, y, r]) => (
        <ellipse cx={x} cy={y} rx="52" ry="30" fill={G.leaf} transform={`rotate(${r} ${x} ${y})`} />
      ))}
      <path d="M248 166l44 8M348 148l44 -6" stroke={G.light} stroke-width="4" stroke-linecap="round" />
    </g>
  )}
  {name === 'systems' && (
    <g>
      <rect x="140" y="170" width="360" height="190" rx="22" fill={G.bench} />
      <rect x="140" y="170" width="360" height="40" rx="20" fill={G.emerald} />
      <path d="M180 250c40-20 80 20 120 0s80-20 120 0s60 20 60 0" fill="none" stroke={G.leaf} stroke-width="6" />
      {[220, 320, 420].map((x) => (
        <g>
          <ellipse cx={x} cy="140" rx="46" ry="34" fill={G.leaf} /><ellipse cx={x - 14} cy="128" rx="22" ry="16" fill={G.light} />
          <path d={`M${x} 210v90M${x - 16} 216l-6 70M${x + 16} 216l6 70`} stroke={G.root} stroke-width="4" stroke-linecap="round" />
        </g>
      ))}
      <circle cx="470" cy="320" r="8" fill={G.white} /><circle cx="455" cy="300" r="5" fill={G.white} />
    </g>
  )}
  {name === 'nutrients' && (
    <g>
      {[[170, '#0F6B4F'], [270, '#3E9B6A'], [370, '#7FC48E']].map(([x, c]) => (
        <g><rect x={x as number} y="140" width="80" height="200" rx="18" fill={c as string} /><rect x={(x as number) + 22} y="110" width="36" height="34" rx="8" fill={G.night} /><rect x={(x as number) + 14} y="210" width="52" height="60" rx="8" fill={G.bench} /></g>
      ))}
      <rect x="480" y="120" width="56" height="220" rx="28" fill={G.night} />
      <rect x="492" y="140" width="32" height="54" rx="8" fill={G.lime} />
      <path d="M508 340v40" stroke={G.night} stroke-width="10" stroke-linecap="round" />
    </g>
  )}
  {name === 'buyer' && (
    <g>
      <path d="M160 180l160-70 160 70v150l-160 60-160-60z" fill={G.bench} />
      <path d="M160 180l160 64 160-64M320 244v146" fill="none" stroke={G.emerald} stroke-width="6" stroke-linejoin="round" />
      <ellipse cx="320" cy="96" rx="60" ry="40" fill={G.leaf} /><ellipse cx="296" cy="84" rx="26" ry="18" fill={G.light} />
      <circle cx="470" cy="120" r="34" fill={G.emerald} /><path d="M454 120l12 12 22-24" fill="none" stroke={G.white} stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
  {name === 'reviews' && (
    <g>
      <rect x="170" y="70" width="300" height="290" rx="22" fill={G.bench} />
      {[130, 190, 250].map((y) => (<g><rect x="210" y={y} width="34" height="34" rx="8" fill={G.emerald} /><path d={`M218 ${y + 17}l7 7 12-14`} fill="none" stroke={G.white} stroke-width="4" stroke-linecap="round" /><rect x="260" y={y + 8} width="170" height="16" rx="8" fill={G.wash} /></g>))}
      <circle cx="470" cy="320" r="46" fill="none" stroke={G.emerald} stroke-width="12" /><path d="M502 352l42 42" stroke={G.emerald} stroke-width="14" stroke-linecap="round" />
    </g>
  )}
  {(name === 'tools' || name === 'equipment') && (
    <g>
      <rect x="190" y="70" width="260" height="290" rx="30" fill={G.night} stroke={G.leaf} stroke-width="4" />
      <rect x="225" y="105" width="190" height="90" rx="14" fill={G.lime} />
      <text x="320" y="166" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="44" font-weight="700" fill={G.night}>5.8</text>
      {[0, 1, 2, 3, 4, 5].map((i) => <rect x={235 + (i % 3) * 60} y={225 + Math.floor(i / 3) * 56} width="48" height="40" rx="10" fill={G.panel} stroke={G.leaf} stroke-width="2" />)}
    </g>
  )}
  {(name === 'problems' || name === 'compare') && (
    <g>
      <ellipse cx="320" cy="200" rx="150" ry="100" fill={G.leaf} />
      <ellipse cx="280" cy="180" rx="60" ry="40" fill={G.light} />
      <circle cx="380" cy="230" r="18" fill="#C9872D" /><circle cx="340" cy="260" r="10" fill="#C9872D" />
      <circle cx="470" cy="300" r="56" fill="none" stroke={G.lime} stroke-width="12" /><path d="M510 340l50 50" stroke={G.lime} stroke-width="16" stroke-linecap="round" />
    </g>
  )}
</svg>
