---
import { findAuthor } from '../../data/authors.ts';

interface Props {
  name: string;
}

const author = findAuthor(Astro.props.name);
---
{author && (
  <aside class="mt-12 rounded-2xl border border-hydro-deep/10 bg-water-mist p-6" aria-labelledby="author-bio-heading">
    <p class="font-mono text-xs font-semibold tracking-[0.08em] text-hydro-teal uppercase">About the author</p>
    <h2 id="author-bio-heading" class="mt-2 font-heading text-xl font-bold text-hydro-deep">{author.name} <span class="font-body text-base font-normal text-slate">· {author.role}</span></h2>
    <p class="mt-3 text-base leading-7 text-ink">{author.bio}</p>
    <p class="mt-3 text-sm"><a class="hr-focus text-hydro-teal underline underline-offset-4" href={author.profilePath}>More about HydroRigor and its editorial standards</a></p>
  </aside>
)}
