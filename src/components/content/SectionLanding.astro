---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { pageTitle } from '../../lib/seo.ts';
import type { SectionDefinition } from '../../lib/sections.ts';
import CommercialSectionStatus from '../commercial/CommercialSectionStatus.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import { contentItems, getContentPath } from '../../data/content-manifest.ts';
import { EMPTY_SECTION_PATHS } from '../../lib/indexing.ts';
import { readingMinutes } from '../../lib/reading.ts';
import { guidePhotoKeys, photos, sectionPhotoKeys } from '../../data/photos.ts';
import { brandedShareImage } from '../../lib/social-image.ts';
import Photo from '../Photo.astro';
import PhotoCredit from '../PhotoCredit.astro';
import { getCollection } from 'astro:content';

interface Props {
  section: SectionDefinition;
}

const { section } = Astro.props;
const pathname = `/${section.slug}/`;
const entries = [
  ...(await getCollection('articles', ({ data }) => !data.draft)),
  ...(await getCollection('reviews', ({ data }) => !data.draft)),
];
const entryByRoute = new Map(entries.map((entry) => [entry.data.route, entry]));

const bannerKey = sectionPhotoKeys[section.id];
const banner = bannerKey ? photos[bannerKey] : undefined;
const image = brandedShareImage(`section-${section.id}`, section.title, banner);

const DAY = 24 * 60 * 60 * 1000;
const NEW_FOR_DAYS = 14;
const builtAt = Date.now();
const shortDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const firstDiagram = (body = '') => body.match(/\]\((\/images\/guides\/[a-z0-9-]+\.svg)\)/u)?.[1];

// Newest first, and no photo twice on the page: a guide whose photo is already used (by the
// banner or an earlier card) shows its own diagram instead, or a plain pattern if it has none.
const usedPhotos = new Set<string>(bannerKey ? [bannerKey] : []);
const cards = contentItems
  .filter(({ category }) => category === section.id)
  .map((item) => {
    const entry = entryByRoute.get(item.route);
    const updated = entry?.data.updatedDate ?? entry?.data.publishDate;
    const published = entry?.data.publishDate;
    return { item, entry, updated, published };
  })
  .sort((a, b) => (b.updated?.getTime() ?? 0) - (a.updated?.getTime() ?? 0) || a.item.title.localeCompare(b.item.title))
  .map(({ item, entry, updated, published }) => {
    const key = guidePhotoKeys[item.route];
    const photo = key && !usedPhotos.has(key) ? photos[key] : undefined;
    if (key && photo) usedPhotos.add(key);
    return {
      href: getContentPath(item),
      title: item.title,
      minutes: readingMinutes(entry?.body),
      updated,
      isNew: published !== undefined && builtAt - published.getTime() < NEW_FOR_DAYS * DAY,
      photo,
      diagram: photo ? undefined : firstDiagram(entry?.body),
    };
  });
const lastUpdated = cards.reduce<Date | undefined>((latest, card) => (card.updated && (!latest || card.updated > latest) ? card.updated : latest), undefined);

// One original diagram per section, taken from the guide that explains it (alt text and caption
// come from that guide, where every number is sourced).
const glanceDiagrams: Partial<Record<SectionDefinition['id'], { route: string; file: string }>> = {
  systems: { route: 'hydroponic-system-for-home-growers', file: 'home-hydroponic-systems-cross-section.svg' },
  crops: { route: 'hydroponic-lettuce', file: 'lettuce-quick-reference.svg' },
  nutrients: { route: 'hydroponic-nutrients', file: 'nutrients-mixing-steps.svg' },
  best: { route: 'hydroponic-system-for-home-growers', file: 'home-hydroponic-system-by-crop.svg' },
};
const glance = (() => {
  const choice = glanceDiagrams[section.id];
  const entry = choice && entryByRoute.get(choice.route);
  const item = choice && contentItems.find(({ route }) => route === choice.route);
  if (!choice || !entry || !item) return undefined;
  const escaped = choice.file.replace(/[.]/gu, '\\.');
  const match = entry.body?.match(new RegExp(`!\\[([^\\]]+)\\]\\(/images/guides/${escaped}\\)(?:\\s*\\n\\s*\\n\\*([^*\\n]+)\\*)?`, 'u'));
  if (!match) return undefined;
  const src = `/images/guides/${choice.file}`;
  const svg = readFileSync(join(process.cwd(), 'public', src), 'utf8');
  const [, width, height] = svg.match(/viewBox="[\d.-]+[\s,]+[\d.-]+[\s,]+([\d.]+)[\s,]+([\d.]+)"/u) ?? [];
  const tall = Number(height) > Number(width) * 1.15;
  return { src, alt: match[1], caption: match[2], width, height, tall, guideTitle: item.title, guideHref: getContentPath(item) };
})();
---
<BaseLayout title={pageTitle(section.title)} description={section.description} noindex={EMPTY_SECTION_PATHS.has(pathname)} image={image}>
  <section class="py-10 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: section.title, url: pathname },
      ]} />
      <div class="grid items-center gap-8 lg:grid-cols-[1.1fr_.9fr] lg:gap-10">
        <div>
          <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">{section.eyebrow}</p>
          <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">{section.title}</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate">{section.description}</p>
          <p class="mt-5 max-w-3xl text-base leading-7 text-ink">{section.intro}</p>
        </div>
        {banner && (
          <figure data-pagefind-ignore="all">
            <div class="aspect-[16/9] overflow-hidden rounded-[1.5rem] bg-water-mist lg:aspect-[4/3] lg:rounded-[1.75rem]">
              <Photo photo={banner} eager sizes="(min-width: 1024px) 540px, calc(100vw - 2rem)" widths={[400, 640, 960, 1280]} class="h-full w-full object-cover" />
            </div>
            <figcaption><PhotoCredit photo={banner} class="mt-2" /></figcaption>
          </figure>
        )}
      </div>

      {cards.length > 0 && (
        <section class="mt-12 sm:mt-14" aria-labelledby="published-heading">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 id="published-heading" class="font-heading text-2xl font-extrabold tracking-[-0.02em] text-hydro-deep">Published guides</h2>
            <p class="text-sm text-slate">
              {cards.length} {cards.length === 1 ? 'guide' : 'guides'}{lastUpdated && <>, last updated <time datetime={lastUpdated.toISOString().slice(0, 10)}>{shortDate(lastUpdated)}</time></>}
            </p>
          </div>
          <ul class="mt-5 grid gap-3 sm:mt-6 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
            {cards.map((card) => (
              <li>
                <a class="hr-focus group flex h-full items-center gap-4 rounded-[1.1rem] border border-line bg-white p-2.5 no-underline transition hover:-translate-y-0.5 hover:shadow-[var(--hr-shadow-soft)] sm:flex-col sm:items-stretch sm:gap-0 sm:overflow-hidden sm:rounded-[1.4rem] sm:p-0" href={card.href}>
                  <span class="block size-[5.5rem] shrink-0 overflow-hidden rounded-[0.8rem] bg-water-mist sm:aspect-[16/9] sm:size-auto sm:w-full sm:rounded-none">
                    {card.photo ? (
                      <Photo photo={card.photo} decorative sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 88px" widths={[240, 480, 640, 800]} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
                    ) : card.diagram ? (
                      <img src={card.diagram} alt="" loading="lazy" decoding="async" class="h-full w-full bg-white object-contain p-1.5" />
                    ) : (
                      <span class="hr-grid-lines block h-full w-full" />
                    )}
                  </span>
                  <span class="block min-w-0 sm:p-5">
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold text-hydro-teal sm:text-sm">
                      {card.isNew && <span class="rounded-full bg-hydro-deep px-2 py-0.5 text-[0.6875rem] font-bold tracking-[0.04em] text-leaf-bright uppercase">New</span>}
                      {card.updated && <span>Updated <time datetime={card.updated.toISOString().slice(0, 10)}>{shortDate(card.updated)}</time></span>}
                      <span aria-hidden="true">·</span>
                      <span>{card.minutes} min read</span>
                    </span>
                    <span class="mt-1 block font-heading text-base leading-snug font-bold text-hydro-deep group-hover:text-hydro-teal sm:mt-1.5 sm:text-lg">{card.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {glance && (
        <section class="mt-12 sm:mt-14" aria-labelledby="glance-heading">
          <h2 id="glance-heading" class="font-heading text-2xl font-extrabold tracking-[-0.02em] text-hydro-deep">At a glance</h2>
          <figure class:list={['mt-5 sm:mt-6', glance.tall ? 'max-w-lg' : 'max-w-4xl']}>
            <a class="hr-focus block rounded-[1.4rem] border border-line bg-white p-1 text-right no-underline sm:p-2" href={glance.src}>
              <img src={glance.src} alt={glance.alt} width={glance.width} height={glance.height} loading="lazy" decoding="async" class="h-auto w-full rounded-[1rem]" />
              <span aria-hidden="true" class="mt-2 mr-1 mb-1 inline-block rounded-full bg-water-mist px-3 py-1.5 font-heading text-[0.8125rem] font-bold text-hydro-teal sm:hidden">Tap to enlarge</span>
              <span aria-hidden="true" class="mt-2 mr-1 mb-1 inline-block rounded-full bg-water-mist px-3 py-1.5 font-heading text-[0.8125rem] font-bold text-hydro-teal max-sm:hidden">Open full size</span>
            </a>
            <figcaption class="mt-3 text-[0.9375rem] leading-6 text-slate">
              {glance.caption && <>{glance.caption} </>}From <a class="text-hydro-teal underline underline-offset-2" href={glance.guideHref}>{glance.guideTitle}</a>.
            </figcaption>
          </figure>
        </section>
      )}

      {cards.length === 0 && (
        <>
          <h2 class="mt-14 font-heading text-2xl font-extrabold tracking-[-0.02em] text-hydro-deep">What this section will cover</h2>
          <div class="mt-6 grid gap-5 lg:grid-cols-3">
            {section.groups.map((group) => (
              <section class="rounded-2xl border border-line bg-white p-6">
                <h3 class="font-heading text-xl font-bold text-hydro-deep">{group.title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate">{group.description}</p>
                <ul class="mt-5 grid gap-2 text-sm text-ink">
                  {group.topics.map((topic) => (
                    <li class="flex gap-2"><span aria-hidden="true" class="text-leaf-signal">●</span><span>{topic}</span></li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          <aside class="mt-10 rounded-2xl border border-amber-measure/30 bg-mineral-sand p-6" aria-labelledby="availability-heading">
            <h2 id="availability-heading" class="font-heading text-lg font-bold text-hydro-deep">What is available now</h2>
            <p class="mt-2 max-w-4xl text-sm leading-6 text-ink">{section.availability}</p>
          </aside>
        </>
      )}

      <CommercialSectionStatus sectionId={section.id} />

      <section class="mt-12" aria-labelledby="next-heading">
        <h2 id="next-heading" class="font-heading text-2xl font-bold text-hydro-deep">Continue your path</h2>
        <div class="mt-5 flex flex-wrap gap-3">
          {section.nextSteps.map((item) => (
            <a class="hr-focus rounded-lg border border-hydro-teal/25 bg-white px-4 py-3 text-sm font-bold text-hydro-deep no-underline hover:border-hydro-teal hover:text-hydro-teal" href={item.href}>{item.label}</a>
          ))}
          <a class="hr-focus rounded-lg bg-hydro-teal px-4 py-3 text-sm font-bold text-white no-underline hover:bg-hydro-deep" href="/search/">Search HydroRigor</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
