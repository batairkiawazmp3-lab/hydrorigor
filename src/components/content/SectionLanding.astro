---
import type { SectionDefinition } from '../../lib/sections.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';

interface Props {
  section: SectionDefinition;
}

const { section } = Astro.props;
---
<BaseLayout title={`${section.title} — HydroRigor`} description={section.description}>
  <section class="py-16 sm:py-20">
    <div class="hr-container">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: section.title, url: `/${section.slug}/` },
      ]} />
      <div class="hr-reading">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-hydro-teal uppercase">M02 route foundation</p>
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-[-0.045em] text-hydro-deep sm:text-5xl">{section.title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate">{section.description}</p>
        <p class="mt-6 rounded-xl border border-hydro-deep/10 bg-white p-5 text-sm leading-6 text-slate">This M02 landing proves the route and SEO architecture. Production content and later-milestone features are intentionally not published here.</p>
      </div>
    </div>
  </section>
</BaseLayout>
