---
import { findAuthor } from '../../data/authors.ts';

interface Props {
  author: string;
  publishDate: Date;
  updatedDate?: Date | undefined;
  reviewer?: string | undefined;
  testedBy?: string | undefined;
  /** One line: "By Najeeb · Updated Nov 2, 2026" plus any slotted items. */
  compact?: boolean;
}

const { author, publishDate, updatedDate, reviewer, testedBy, compact = false } = Astro.props;
const authorProfile = findAuthor(author);
const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
const shortDate = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' });
const isoDay = (date: Date) => date.toISOString().slice(0, 10);
const shownDate = updatedDate ?? publishDate;
---
{compact ? (
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate">
    <span>By {authorProfile ? <a class="hr-focus font-semibold text-hydro-teal underline underline-offset-4" href={authorProfile.profilePath}>{author}</a> : <span class="font-semibold text-hydro-deep">{author}</span>}</span>
    <span aria-hidden="true">·</span>
    <span>{updatedDate ? 'Updated' : 'Published'} <time datetime={isoDay(shownDate)}>{shortDate.format(shownDate)}</time></span>
    {reviewer && (<><span aria-hidden="true">·</span><span>Reviewed by {reviewer}</span></>)}
    <slot />
  </p>
) : (
<dl class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate">
  <div class="flex gap-2">
    <dt class="font-semibold text-hydro-deep">Author</dt>
    <dd>{authorProfile ? <a class="hr-focus text-hydro-teal underline underline-offset-4" href={authorProfile.profilePath}>{author}</a> : author}</dd>
  </div>
  <div class="flex gap-2">
    <dt class="font-semibold text-hydro-deep">Published</dt>
    <dd><time datetime={isoDay(publishDate)}>{dateFormatter.format(publishDate)}</time></dd>
  </div>
  {updatedDate && (
    <div class="flex gap-2">
      <dt class="font-semibold text-hydro-deep">Updated</dt>
      <dd><time datetime={isoDay(updatedDate)}>{dateFormatter.format(updatedDate)}</time></dd>
    </div>
  )}
  {reviewer && (
    <div class="flex gap-2">
      <dt class="font-semibold text-hydro-deep">Reviewed by</dt>
      <dd>{reviewer}</dd>
    </div>
  )}
  {testedBy && (
    <div class="flex gap-2">
      <dt class="font-semibold text-hydro-deep">Tested by</dt>
      <dd>{testedBy}</dd>
    </div>
  )}
</dl>
)}
