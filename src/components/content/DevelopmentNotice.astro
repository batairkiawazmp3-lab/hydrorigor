---
interface Props {
  draft: boolean;
}

const { draft } = Astro.props;
---
{draft && (
  <aside class="mb-8 rounded-xl border border-amber-measure/40 bg-mineral-sand p-5" aria-label="Development fixture notice">
    <p class="font-mono text-xs font-semibold tracking-[0.08em] text-amber-measure uppercase">Sample development fixture · Noindex</p>
    <p class="mt-2 text-sm leading-6 text-ink">This page exists only to validate the M02 content engine. It is not production editorial content, a product recommendation, a rating, or a claim of hands-on testing.</p>
  </aside>
)}
