---
interface Props {
  draft: boolean;
}

const { draft } = Astro.props;
---
{draft && (
  <aside class="mb-8 rounded-xl border border-amber-measure/40 bg-mineral-sand p-5" aria-label="Draft notice">
    <p class="font-mono text-xs font-semibold tracking-[0.08em] text-amber-measure uppercase">Draft · Noindex</p>
    <p class="mt-2 text-sm leading-6 text-ink">This unpublished page is excluded from production indexing.</p>
  </aside>
)}
