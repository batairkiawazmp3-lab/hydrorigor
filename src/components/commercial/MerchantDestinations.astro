---
import AffiliateLink from './AffiliateLink.astro';
import { resolveCommercialDestination } from '../../lib/commercial/registry.ts';

interface Props {
  destinationIds: string[];
}

const { destinationIds } = Astro.props;
const destinations = destinationIds.map(resolveCommercialDestination);
---
<section class="mt-8 rounded-2xl border border-hydro-deep/10 bg-white p-6" aria-labelledby="merchant-destinations-heading">
  <h2 id="merchant-destinations-heading" class="font-heading text-xl font-bold text-hydro-deep">Merchant destinations</h2>
  {destinations.length > 0 ? (
    <ul class="mt-4 flex flex-wrap gap-3">
      {destinations.map((destination) => <li><AffiliateLink destinationId={destination.id} /></li>)}
    </ul>
  ) : (
    <p class="mt-3 text-sm leading-6 text-slate">No merchant destination is configured for this page. HydroRigor does not provide a purchase link when a relationship and destination have not been explicitly recorded.</p>
  )}
</section>
