---
import type { CommercialDestination } from '../../lib/commercial/models.ts';
import { getCommercialLinkAttributes } from '../../lib/commercial/registry.ts';

interface Props {
  destination: CommercialDestination;
}

const { destination } = Astro.props;
const attributes = getCommercialLinkAttributes(destination);
---
<a
  class="hr-focus inline-flex rounded-lg bg-hydro-deep px-4 py-3 font-semibold text-white no-underline hover:bg-hydro-teal"
  href={attributes.href}
  target={attributes.target}
  rel={attributes.rel}
  data-commercial-relationship={attributes.relationship}
>
  <slot>{destination.label}</slot>
</a>
