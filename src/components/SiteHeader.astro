---
import BrandMark from './BrandMark.astro';
const nav = [
  ['Systems', '#systems'],
  ['Crops', '#crops'],
  ['Tools', '#tools'],
  ['About', '#about'],
];
---
<header class="border-b border-hydro-deep/10 bg-white/[0.88] backdrop-blur">
  <div class="hr-container flex min-h-18 flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3 md:flex-nowrap md:py-0">
    <BrandMark />
    <nav aria-label="Primary navigation" class="order-3 flex w-full flex-wrap items-center justify-center gap-x-4 gap-y-1 border-t border-hydro-deep/10 pt-2 md:order-none md:w-auto md:flex-nowrap md:justify-start md:gap-6 md:border-t-0 md:pt-0">
      {nav.map(([label, href]) => (
        <a class="hr-focus rounded-md px-1 py-2 text-sm font-semibold text-slate no-underline hover:text-hydro-teal" href={href}>{label}</a>
      ))}
    </nav>
    <a class="hr-focus rounded-[10px] bg-hydro-teal px-4 py-2.5 text-sm font-bold text-white no-underline transition hover:bg-hydro-deep" href="#start">Start here</a>
  </div>
</header>
