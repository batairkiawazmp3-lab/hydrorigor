---
import BrandMark from './BrandMark.astro';
import { searchLink, sectionNavigation, startLink } from '../lib/navigation.ts';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---
<header class="relative z-40 border-b border-hydro-deep/10 bg-white/[0.94] backdrop-blur">
  <div class="hr-container flex min-h-18 flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3 md:flex-nowrap md:py-0">
    <BrandMark />
    <nav aria-label="Primary navigation" class="order-3 flex w-full flex-wrap items-center gap-2 border-t border-hydro-deep/10 pt-3 md:order-none md:w-auto md:flex-nowrap md:justify-end md:border-t-0 md:pt-0">
      <a
        class="hr-focus rounded-lg bg-hydro-teal px-3 py-2 text-sm font-bold text-white no-underline transition hover:bg-hydro-deep"
        href={startLink.href}
        aria-current={isCurrent(startLink.href) ? 'page' : undefined}
      >{startLink.label}</a>
      <a
        class="hr-focus rounded-lg border border-hydro-deep/15 bg-white px-3 py-2 text-sm font-semibold text-hydro-deep no-underline hover:border-hydro-teal hover:text-hydro-teal"
        href={searchLink.href}
        aria-current={isCurrent(searchLink.href) ? 'page' : undefined}
      >{searchLink.label}</a>
      <details class="group relative w-full sm:w-auto">
        <summary class="hr-focus flex cursor-pointer list-none items-center justify-between gap-3 rounded-lg border border-hydro-deep/15 bg-water-mist px-3 py-2 text-sm font-bold text-hydro-deep [&::-webkit-details-marker]:hidden">
          Explore topics
          <span aria-hidden="true" class="text-hydro-teal transition group-open:rotate-180">⌄</span>
        </summary>
        <div class="mt-3 grid gap-2 rounded-xl border border-hydro-deep/10 bg-white p-3 shadow-[var(--hr-shadow-soft)] sm:absolute sm:right-0 sm:w-[38rem] sm:grid-cols-2">
          {sectionNavigation.map((item) => (
            <a
              class="hr-focus rounded-lg p-3 no-underline hover:bg-water-mist"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <span class="block font-heading text-sm font-bold text-hydro-deep">{item.label}</span>
              <span class="mt-1 block text-xs leading-5 text-slate">{item.description}</span>
            </a>
          ))}
        </div>
      </details>
    </nav>
  </div>
</header>
