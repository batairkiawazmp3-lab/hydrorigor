{
  "name": "hydrorigor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "node scripts/lint.mjs",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:data": "node scripts/validate-data.mjs",
    "test:commerce": "node scripts/validate-commerce.mjs",
    "test:content": "node scripts/validate-content.mjs",
    "build": "astro build && pagefind --site dist",
    "test:search": "node scripts/test-search.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.0",
    "astro": "7.3.2",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "pagefind": "1.5.2",
    "typescript": "^6.0.0"
  }
}
